# Copy to .env next to obsidian.sh. Never put a password in this file.

# Name of the duplicacy storage that obsidian.sh backs up to and prunes.
# Empty means the first storage in .duplicacy/preferences.
DUPLICACY_STORAGE=

# Path to the GCS token file, if it does not come from the keychain. Duplicacy
# reads DUPLICACY_GCS_TOKEN for the storage named "default" and
# DUPLICACY_<NAME>_GCS_TOKEN for any other storage, for example
# DUPLICACY_ENCRYPTED_GCS_TOKEN. The value is a path, not the token itself.
DUPLICACY_GCS_TOKEN=
